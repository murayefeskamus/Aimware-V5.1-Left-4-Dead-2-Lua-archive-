local WEAPONS = {
    ["CWeaponPistol"]    = true,
    ["CWeaponMagnum"]    = true,
    ["CSubMachinegun"]   = true,
    ["CRifle"]           = true,
    ["CRifleDesert"]     = true,
}

local IN_ATTACK   = 1
local CHOKE_DEPTH = 2

local function IsSupportedWeapon(cls)
    if cls == nil then return false end
    if WEAPONS[cls] then return true end
    if string.find(cls, "Pistol")        then return true end
    if string.find(cls, "Magnum")        then return true end
    if string.find(cls, "SubMachinegun") then return true end
    if string.find(cls, "SMG")           then return true end
    if string.find(cls, "Rifle")         then return true end
    return false
end

local function GetActiveWeapon(ply)
    local ok, wep = pcall(function() return ply:GetPropEntity("m_hActiveWeapon") end)
    if ok and wep then return wep end
    local ok2, h = pcall(function() return ply:GetProp("m_hActiveWeapon") end)
    if ok2 and type(h) == "number" and h ~= 0 and h ~= -1 then
        return entities.GetByIndex(h % 2048)
    end
    return nil
end

local function GetClassSafe(ent)
    if ent == nil then return nil end
    local ok, cls = pcall(function() return ent:GetClass() end)
    if not ok then return nil end
    return cls
end

local phase          = 0
local original_angle = nil

callbacks.Register("CreateMove", "psilent_v3", function(cmd)
    if not cmd then return end

    local me = entities.GetLocalPlayer()
    if not me or not me:IsAlive() then
        phase = 0
        original_angle = nil
        cmd:SetSendPacket(true)
        return
    end

    local wep = GetActiveWeapon(me)
    if not wep then return end

    local cls = GetClassSafe(wep)
    if not IsSupportedWeapon(cls) then return end

    local buttons   = cmd:GetButtons()
    local attacking = bit.band(buttons, IN_ATTACK) ~= 0

    if not attacking then
        original_angle = cmd:GetViewAngles()
        if phase ~= 0 then
            phase = 0
            cmd:SetSendPacket(true)
        end
        return
    end

    if phase < CHOKE_DEPTH then
        cmd:SetSendPacket(false)
        phase = phase + 1
    else
        if original_angle then
            cmd:SetViewAngles(original_angle)
        end
        cmd:SetButtons(bit.band(buttons, bit.bnot(IN_ATTACK)))
        cmd:SetSendPacket(true)
        phase = 0
    end
end)

callbacks.Register("Unload", "psilent_unload", function()
    phase = 0
    original_angle = nil
end)
