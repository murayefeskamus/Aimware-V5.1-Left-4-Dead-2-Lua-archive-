    local ptr = ci(v, nil)
    if ptr and ffi.cast("uintptr_t", ptr) ~= 0 then
        baseClient = ptr
        print("[Choke] Interface: " .. v)
        break
    end
end
if not baseClient then print("[Choke] baseClient alinamadi") return end

ffi.cdef[[
    typedef struct {
        uint8_t* pData;
        int      nDataBytes;
        int      nDataBits;
        int      iCurBit;
        bool     bOverflow;
    } bf_write_t;
]]

local vtable  = ffi.cast("uintptr_t**", baseClient)[0]
local WUD_t   = ffi.typeof("bool(__fastcall*)(void*, void*, void*, int, int, bool)")
local pWUD    = ffi.cast(WUD_t, vtable[22])

local CHOKE_MAX  = 14
local chokeTick  = 0
local lastTo     = -1
local buf        = ffi.new("uint8_t[2048]")
local bfw        = ffi.new("bf_write_t")

callbacks.Register("CreateMove", "choke_wud", function(cmd)
    local to = globals.TickCount()
    if lastTo == -1 then lastTo = to - 1 end

    chokeTick = chokeTick + 1
    if chokeTick <= CHOKE_MAX then return end
    chokeTick = 0

 
    bfw.pData     = buf
    bfw.nDataBytes = 2048
    bfw.nDataBits  = 2048 * 8
    bfw.iCurBit    = 0
    bfw.bOverflow  = false

    local ok, res = pcall(pWUD, baseClient, nil,
        ffi.cast("void*", bfw), lastTo, to, true)
    if ok then
        print(string.format("[Choke] Gonderildi from=%d to=%d result=%s",
            lastTo, to, tostring(res)))
    else
        print("[Choke] Hata: " .. tostring(res))
    end

    lastTo = to
end)

callbacks.Register("Unload", function()
    callbacks.Unregister("CreateMove", "choke_wud")
    print("[Choke] Kaldirildi")
end)
