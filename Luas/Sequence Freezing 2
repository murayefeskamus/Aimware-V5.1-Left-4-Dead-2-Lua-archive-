local ref = gui.Reference("MISC", "GENERAL", "Extra")
local group = gui.Groupbox(ref, "pirtiprt", 16, 16, 260, 0)
local enable = gui.Checkbox(group, "pirt_enable", "Enable Pirt", true)

callbacks.Register("CreateMove", "hitchance_bhop_main", function(cmd)
    if not enable:GetValue() then return end

    local lp = entities.GetLocalPlayer()
    if not lp or not lp:IsAlive() then return end

    if input.IsButtonDown(32) then
        local flags = lp:GetPropInt("m_fFlags") or 0
        local on_ground = (bit.band(flags, 1) ~= 0)
        local buttons = cmd:GetButtons() or cmd.buttons or 0

        if not on_ground then
            local new_buttons = bit.band(buttons, bit.bnot(2))
            cmd:SetButtons(new_buttons)
            cmd.buttons = new_buttons
        else
            local chance = hitchance:GetValue()
            if chance >= 100 or math.random(1, 100) <= chance then
                local new_buttons = bit.bor(buttons, 2)
                cmd:SetButtons(new_buttons)
                cmd.buttons = new_buttons
            else
                local new_buttons = bit.band(buttons, bit.bnot(2))
                cmd:SetButtons(new_buttons)
                cmd.buttons = new_buttons
            end
        end
    end
end)
