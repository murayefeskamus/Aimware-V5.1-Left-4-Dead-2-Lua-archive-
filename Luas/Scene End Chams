
local ref    = gui.Reference("Misc", "General", "Extra")
local enable = gui.Checkbox(ref, "ffi.se.on", "SceneEnd Chams", false)
local mat_cb = gui.Combobox(ref, "ffi.se.mat", "SE Material",
    "Shaded", "Metallic", "Flat", "Wireframe2")
local col_r = gui.Slider(ref, "ffi.se.r", "SE R", 255, 0, 255, 1)
local col_g = gui.Slider(ref, "ffi.se.g", "SE G",  80, 0, 255, 1)
local col_b = gui.Slider(ref, "ffi.se.b", "SE B",  80, 0, 255, 1)

ffi.cdef[[
    void* GetModuleHandleA(const char* lpModuleName);
    void* GetProcAddress(void* hModule, const char* lpProcName);
    int   VirtualProtect(void* lpAddress, size_t dwSize, unsigned long flNewProtect, unsigned long* lpflOldProtect);
    typedef struct {
        float  origin[3];
        float  angles[3];
        void*  pRenderable;
        void*  pModel;
        void*  pModelToWorld;
        void*  pLightingOffset;
        void*  pLightingOrigin;
        int    flags;
        int    entity_index;
        int    skin;
        int    body;
        int    hitboxset;
        unsigned short instance;
        unsigned short _pad;
    } ModelRenderInfo_t;
]]

local function GetInterface(dll, name)
    local mod = ffi.C.GetModuleHandleA(dll)
    if mod == nil then return nil end
    local ci = ffi.cast("void*(__cdecl*)(const char*, int*)",
        ffi.C.GetProcAddress(mod, "CreateInterface"))
    return ci(name, nil)
end

local model_render = GetInterface("engine.dll", "VEngineModel016")
if not model_render then print("[SE] model_render yok") return end

local mat_sys = GetInterface("materialsystem.dll", "VMaterialSystem080")
if not mat_sys then print("[SE] mat_sys yok") return end


local render_view = GetInterface("engine.dll", "VEngineRenderView013")
if not render_view then print("[SE] render_view yok") return end

local MAT_PATHS = {
    [0]="debug/debugambientcube", [1]="//platform/materials/debug/env_cubemap_model",
    [2]="debug/debugtranslucentsinglecolor", [3]="//platform/materials/debug/debugmrmnormals"
}

local find_mat = ffi.cast("void*(__thiscall*)(void*, const char*, const char*, int, const char*)",
    ffi.cast("uintptr_t**", mat_sys)[0][71])

local mat_cache = {}; local sf_fns = {}; local sc_fns = {}
for i = 0, 3 do
    local m = find_mat(mat_sys, MAT_PATHS[i], "Model textures", 0, nil)
    if m and ffi.cast("uintptr_t", m) ~= 0 then
        ffi.cast("void(__thiscall*)(void*)", ffi.cast("uintptr_t**", m)[0][12])(m)
        mat_cache[i] = m
        sf_fns[i] = ffi.cast("void(__thiscall*)(void*, int, int)",            ffi.cast("uintptr_t**", m)[0][29])
        sc_fns[i] = ffi.cast("void(__thiscall*)(void*, float, float, float)", ffi.cast("uintptr_t**", m)[0][28])
    end
end

local ov_fn = ffi.cast("void(__thiscall*)(void*, void*, int)", ffi.cast("uintptr_t**", model_render)[0][1])
local dme_ex = ffi.cast("int(__thiscall*)(void*, void*)", ffi.cast("uintptr_t**", model_render)[0][16])

local IGNOREZ = bit.lshift(1,15); local ZNEARER = bit.lshift(1,10)
local NOCULL  = bit.lshift(1,13); local NOFOG   = bit.lshift(1,14)


local saved_infos = ffi.new("ModelRenderInfo_t[32]")
local saved_count = 0


local DME_t    = ffi.typeof("void(__fastcall*)(void*, void*, void*, void*, void*)")
local dme_slot = ffi.cast("uintptr_t**", model_render)[0] + 19
local dme_orig = dme_slot[0]
local GC_dme   = {}

local function Hooked_DME(ecx, edx, state, info, btw)
    if enable:GetValue() then
        local eidx = ffi.cast("int*", ffi.cast("uintptr_t", info) + 48)[0]
        if eidx >= 1 and eidx <= 32 and saved_count < 32 then
            ffi.copy(saved_infos + saved_count, info, ffi.sizeof("ModelRenderInfo_t"))
           
            saved_infos[saved_count].pModelToWorld  = nil
            saved_infos[saved_count].pLightingOffset = nil
            saved_infos[saved_count].pLightingOrigin = nil
            saved_count = saved_count + 1
        end
    end
    ffi.cast(DME_t, dme_orig)(ecx, edx, state, info, btw)
end

GC_dme.fn = ffi.cast(DME_t, Hooked_DME)
local old_dme = ffi.new("unsigned long[1]")
ffi.C.VirtualProtect(ffi.cast("void*", dme_slot), 4, 0x40, old_dme)
dme_slot[0] = ffi.cast("uintptr_t", GC_dme.fn)
ffi.C.VirtualProtect(ffi.cast("void*", dme_slot), 4, old_dme[0], old_dme)
print("[SE] DME hook kuruldu")


local SE_t    = ffi.typeof("void(__thiscall*)(void*)")
local se_slot = ffi.cast("uintptr_t**", render_view)[0] + 9
local se_orig = se_slot[0]
local GC_se   = {}

local function Hooked_SceneEnd(ecx)
    ffi.cast(SE_t, se_orig)(ecx) 

    if enable:GetValue() and saved_count > 0 then
        local idx = mat_cb:GetValue()
        local mat = mat_cache[idx]
        local sf  = sf_fns[idx]
        local sc  = sc_fns[idx]
        if mat and sf then
            local r = col_r:GetValue()/255.0
            local g = col_g:GetValue()/255.0
            local b = col_b:GetValue()/255.0

          
            sf(mat, IGNOREZ, 1); sf(mat, ZNEARER, 1); sf(mat, NOCULL, 1); sf(mat, NOFOG, 1)
            if sc then sc(mat, r*0.4, g*0.4, b*0.4) end
            ov_fn(model_render, mat, 0)
            for i = 0, saved_count-1 do dme_ex(model_render, saved_infos + i) end
            ov_fn(model_render, nil, 0)

          
            sf(mat, IGNOREZ, 0)
            if sc then sc(mat, r, g, b) end
            ov_fn(model_render, mat, 0)
            for i = 0, saved_count-1 do dme_ex(model_render, saved_infos + i) end
            ov_fn(model_render, nil, 0)
        end
    end
    saved_count = 0
end

GC_se.fn = ffi.cast(SE_t, Hooked_SceneEnd)
local old_se = ffi.new("unsigned long[1]")
ffi.C.VirtualProtect(ffi.cast("void*", se_slot), 4, 0x40, old_se)
se_slot[0] = ffi.cast("uintptr_t", GC_se.fn)
ffi.C.VirtualProtect(ffi.cast("void*", se_slot), 4, old_se[0], old_se)
print("[SE] SceneEnd hook kuruldu. Slot 9 VEngineRenderView001")

callbacks.Register("Unload", "ffise", function()
    local o1 = ffi.new("unsigned long[1]")
    ffi.C.VirtualProtect(ffi.cast("void*", dme_slot), 4, 0x40, o1)
    dme_slot[0] = dme_orig
    ffi.C.VirtualProtect(ffi.cast("void*", dme_slot), 4, o1[0], o1)
    local o2 = ffi.new("unsigned long[1]")
    ffi.C.VirtualProtect(ffi.cast("void*", se_slot), 4, 0x40, o2)
    se_slot[0] = se_orig
    ffi.C.VirtualProtect(ffi.cast("void*", se_slot), 4, o2[0], o2)
    ov_fn(model_render, nil, 0)
    print("[SE] Temizlendi")
end)

