byte patch in client for annoying message










local ffi = ffi or require("ffi")
pcall(ffi.cdef, [[
    void* GetModuleHandleA(const char* name);
    int   VirtualProtect(void* addr, unsigned long size, unsigned long newProt, unsigned long* oldProt);
]])
local C = ffi.C

local TARGET_RVA = 0x2D2E30
local PATCH      = { 0x32, 0xC0, 0xC2, 0x04, 0x00 }

--(55 8B EC 56 8B 75 08 57 8B F9 85 F6 0F 84)
local SIG = { 0x55, 0x8B, 0xEC, 0x56, 0x8B, 0x75, 0x08, 0x57, 0x8B, 0xF9, 0x85, 0xF6, 0x0F, 0x84 }

local client = C.GetModuleHandleA("client.dll")
if client == nil then
    print("[TooFarHide] client.dll bulunamadi")
    return
end

local base   = tonumber(ffi.cast("uintptr_t", client))
local target = ffi.cast("uint8_t*", base + TARGET_RVA)

for i = 1, #SIG do
    if target[i - 1] ~= SIG[i] then
        print(string.format("[TooFarHide] imza uyusmadi (offset %d), patch atilmadi", i - 1))
        return
    end
end

local saved = {}
for i = 1, #PATCH do saved[i] = target[i - 1] end

local function write_bytes(bytes)
    local old = ffi.new("unsigned long[1]")
    C.VirtualProtect(target, #bytes, 0x40, old)          
    for i = 1, #bytes do target[i - 1] = bytes[i] end
    C.VirtualProtect(target, #bytes, old[0], old)
end

write_bytes(PATCH)
print("[TooFarHide] aktif: mesaj artik gosterilmeyecek")

callbacks.Register("Unload", "ztf_hide_unload", function()
    write_bytes(saved)
    print("[TooFarHide] kaldirildi, orijinal byte'lar geri yazildi")
end)
