local LUT_SIZE  = 32 * 32 * 32  
local LUT_BYTES = LUT_SIZE * 3  
local IDENTITY = {}
do
    local idx = 0
    for b = 0, 31 do
        for g = 0, 31 do
            for r = 0, 31 do
                IDENTITY[idx]   = math.floor(r * 255/31 + 0.5)
                IDENTITY[idx+1] = math.floor(g * 255/31 + 0.5)
                IDENTITY[idx+2] = math.floor(b * 255/31 + 0.5)
                idx = idx + 3
            end
        end
    end
end

local floor = math.floor
local max   = math.max
local min   = math.min
local function fmod1(x)
    x = x % 1.0
    return x < 0 and x + 1.0 or x
end
local function rgb_to_hsv(r, g, b)
    local fr, fg, fb = r/255, g/255, b/255
    local cmax  = max(fr, fg, fb)
    local delta = cmax - min(fr, fg, fb)
    local h     = 0.0
    if delta > 0 then
        if     cmax == fr then h = ((fg - fb) / delta) % 6
        elseif cmax == fg then h = (fb - fr) / delta + 2
        else                   h = (fr - fg) / delta + 4
        end
        h = h / 6.0
    end
    return h, (cmax == 0) and 0.0 or (delta / cmax), cmax
end
local function hsv_to_rgb(h, s, v)
    local hh = h * 6.0
    local i   = floor(hh) % 6
    local f   = hh - floor(hh)
    local p   = v * (1 - s)
    local q   = v * (1 - f * s)
    local t   = v * (1 - (1-f) * s)
    local fr, fg, fb
    if     i == 0 then fr,fg,fb = v,t,p
    elseif i == 1 then fr,fg,fb = q,v,p
    elseif i == 2 then fr,fg,fb = p,v,t
    elseif i == 3 then fr,fg,fb = p,q,v
    elseif i == 4 then fr,fg,fb = t,p,v
    else               fr,fg,fb = v,p,q
    end
    local function c(x) return max(0, min(255, floor(x*255+0.5))) end
    return c(fr), c(fg), c(fb)
end
local function apply_grade(rgb_ptr, orig)
    local hs = cc_hue:GetValue()    / 360.0
    local sm = cc_sat:GetValue()    / 100.0
    local bm = cc_bright:GetValue() / 100.0
    local t  = cc_temp:GetValue()   / 100.0
    local rM = 1.0 + t * 0.40
    local gM = 1.0 + t * 0.08
    local bM = 1.0 - t * 0.40
    for i = 0, LUT_SIZE - 1 do
        local base = i * 3
        local h, s, v = rgb_to_hsv(orig[base], orig[base+1], orig[base+2])
        h = fmod1(h + hs)
        s = max(0, min(1, s * sm))
        v = max(0, min(1, v * bm))
        local r, g, b = hsv_to_rgb(h, s, v)
        rgb_ptr[base]   = max(0, min(255, floor(r * rM + 0.5)))
        rgb_ptr[base+1] = max(0, min(255, floor(g * gM + 0.5)))
        rgb_ptr[base+2] = max(0, min(255, floor(b * bM + 0.5)))
    end
end
local function restore_lut(rgb_ptr, orig)
    for i = 0, LUT_BYTES-1 do rgb_ptr[i] = orig[i] end
end

local function WriteHook(target, dest)
    local old = ffi.new("uint32_t[1]")
    if ffi.C.VirtualProtect(ffi.cast("void*", target), HOOK_SIZE, PAGE_EXECUTE_READWRITE, old) == 0 then
        return false
    end
    local p = ffi.cast("uint8_t*", target)
    p[0] = 0x68 
    ffi.cast("uint32_t*", p + 1)[0] = ffi.cast("uint32_t", ffi.cast("void*", dest))
    p[5] = 0xC3  
    ffi.C.VirtualProtect(ffi.cast("void*", target), HOOK_SIZE, old[0], old)
    return true
end
local function CreateTrampoline(original, n)
    local tramp = ffi.C.VirtualAlloc(nil, 64, MEM_COMMIT + MEM_RESERVE, PAGE_EXECUTE_READWRITE)
    if tramp == nil then return nil end
   
    for i = 0, 63 do ffi.cast("uint8_t*", tramp)[i] = 0x90 end
    
    ffi.C.memcpy(tramp, ffi.cast("void*", original), n)
   
    local jmp = ffi.cast("uint8_t*", tramp) + n
    local ret_addr = ffi.cast("uint8_t*", original) + n
    jmp[0] = 0x68
    ffi.cast("uint32_t*", jmp + 1)[0] = ffi.cast("uint32_t", ret_addr)
    jmp[5] = 0xC3
    return tramp
end

