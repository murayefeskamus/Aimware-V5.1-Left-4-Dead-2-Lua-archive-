local function write_int_safe(addr, val)
    if not addr or addr < 0x10000 then return false end
    memory.write_int(addr, val, true)
    return true
end

local function permachoke()
    local engine_base = modules.get_engine_base()
    if not engine_base or engine_base == 0 then return end


    local client_state_ptr = memory.read_int(engine_base + 4352236)
    if not client_state_ptr or client_state_ptr == 0 then return end

 
    local netchan = memory.read_int(client_state_ptr + 24)
    if not netchan or netchan == 0 then return end


    write_int_safe(netchan + 16, -1)
    write_int_safe(netchan + 28, 255)
end

function on_create_move(cmd, local_player)
    permachoke()
end
