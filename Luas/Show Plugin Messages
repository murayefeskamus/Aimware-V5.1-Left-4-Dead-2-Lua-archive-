pcall(function() ffi.cdef[[
    void* GetModuleHandleA(const char* lpModuleName);
    int   VirtualProtect(void* lpAddress, size_t dwSize, uint32_t flNewProtect, uint32_t* lpflOldProtect);
    void* VirtualAlloc(void* lpAddress, size_t dwSize, uint32_t flAllocationType, uint32_t flProtect);
    void* memcpy(void* dst, const void* src, size_t n);
]] end)

local engineBase = ffi.cast("uintptr_t", ffi.C.GetModuleHandleA("engine.dll"))

local GC = {}

local function WriteHook(target, dest, size)
    local old = ffi.new("uint32_t[1]")
    ffi.C.VirtualProtect(ffi.cast("void*", target), size, 0x40, old)
    local ptr = ffi.cast("uint8_t*", target)
    ptr[0] = 0x68
    ffi.cast("uint32_t*", ptr + 1)[0] = ffi.cast("uint32_t", dest)
    ptr[5] = 0xC3
    ffi.C.VirtualProtect(ffi.cast("void*", target), size, old[0], old)
end

local function RestoreBytes(target, trampoline, size)
    local old = ffi.new("uint32_t[1]")
    ffi.C.VirtualProtect(ffi.cast("void*", target), size, 0x40, old)
    ffi.C.memcpy(ffi.cast("void*", target), trampoline, size)
    ffi.C.VirtualProtect(ffi.cast("void*", target), size, old[0], old)
end

local function CreateTrampoline(src, size)
    local t = ffi.C.VirtualAlloc(nil, 64, 0x3000, 0x40)
    if t == nil then
        print("[ERR] VirtualAlloc failed")
        return nil
    end
    ffi.C.memcpy(t, ffi.cast("const void*", src), size)
    local jmp = ffi.cast("uint8_t*", t) + size
    jmp[0] = 0x68
    ffi.cast("uint32_t*", jmp + 1)[0] = ffi.cast("uint32_t", src + size)
    jmp[5] = 0xC3
    return t
end

local PrintAddr = engineBase + 0x1D1B10
local Print_t   = ffi.typeof("char(__fastcall*)(void*, void*)")

local PrintTramp = CreateTrampoline(PrintAddr, 6)
if not PrintTramp then return end
GC.orig_print = ffi.cast(Print_t, PrintTramp)

local function Hooked_Print(ecx, edx)
    local ok, txt = pcall(function()
        local p = ffi.cast("uintptr_t*", ffi.cast("uintptr_t", ecx) + 0x54)[0]
        if p ~= 0 then return ffi.string(ffi.cast("const char*", p)) end
        return nil
    end)
    if ok and txt then
        local msg = txt:gsub("[\r\n]", "")
        if #msg > 0 then
            print(string.format("[SVC_Print] %s", msg))
        end
    end
    return GC.orig_print(ecx, edx)
end

GC.hook_print = ffi.cast(Print_t, Hooked_Print)
WriteHook(PrintAddr, ffi.cast("uintptr_t", GC.hook_print), 6)


