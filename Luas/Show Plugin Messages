local CVarAddr = engineBase + 0x15DC50
local CVarFn_t = ffi.typeof("char(__fastcall*)(void*, void*)")

local CVarTramp = CreateTrampoline(CVarAddr, 6)
if not CVarTramp then return end
GC.orig_cvar = ffi.cast(CVarFn_t, CVarTramp)

local function Hooked_CVar(ecx, edx)
    local ok, name, cookie = pcall(function()
        local base    = ffi.cast("uintptr_t", ecx)
        local nameptr = ffi.cast("uintptr_t*", base + 0x54)[0]
        if nameptr ~= 0 then
            return ffi.string(ffi.cast("const char*", nameptr)),
                   ffi.cast("int32_t*", base + 0x58)[0]
        end
    end)
    if ok and name then
        print(string.format("[SVC_GetCvarValue] cvar='%s' cookie=%d", name, cookie))
    end
    return GC.orig_cvar(ecx, edx)
end

GC.hook_cvar = ffi.cast(CVarFn_t, Hooked_CVar)
WriteHook(CVarAddr, ffi.cast("uintptr_t", GC.hook_cvar), 6)


