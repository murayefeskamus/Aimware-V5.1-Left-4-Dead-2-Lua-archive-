pcall(function()
    ffi.cdef[[
        bool VirtualProtect(void* lpAddress, uint32_t dwSize, uint32_t flNewProtect, uint32_t* lpflOldProtect);
    ]]
end)

local function write_bytes(addr, bytes)
    local ptr = ffi.cast("uint8_t*", addr)
    local old = ffi.new("uint32_t[1]")
    ffi.C.VirtualProtect(ffi.cast("void*", addr), #bytes, 0x40, old)
    for i, b in ipairs(bytes) do
        ptr[i-1] = b
    end
    ffi.C.VirtualProtect(ffi.cast("void*", addr), #bytes, old[0], old)
end

local p1 = mem.FindPattern("engine.dll", "83 BB 84 00 00 00 01 0F 84 D9 00 00 00")
if p1 then
    local a = ffi.cast("uintptr_t", p1) + 7
    write_bytes(a, {0xE9, 0xDA, 0x00, 0x00, 0x00, 0x90})
    print(string.format("[NSL] case1 patched @ 0x%X", a))
else
    print("[NSL] case1 pattern bulunamadi")
end

