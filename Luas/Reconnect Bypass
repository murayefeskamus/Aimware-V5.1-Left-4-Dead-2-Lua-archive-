

local DEBUG_STATUS = false

ffi.cdef[[
 int RegOpenKeyExA(void* hKey, const char* lpSubKey, unsigned long ulOptions, unsigned long samDesired, void** phkResult);
 int RegQueryValueExA(void* hKey, const char* lpValueName, unsigned long* lpReserved, unsigned long* lpType, unsigned char* lpData, unsigned long* lpcbData);
 int RegCloseKey(void* hKey);
 void* ShellExecuteA(void* hwnd, const char* lpOperation, const char* lpFile, const char* lpParameters, const char* lpDirectory, int nShowCmd);
 void* CreateFileA(const char* lpFileName, unsigned long dwDesiredAccess, unsigned long dwShareMode, void* lpSecurityAttributes, unsigned long dwCreationDisposition, unsigned long dwFlagsAndAttributes, void* hTemplateFile);
 int CloseHandle(void* hObject);
]]

local SW_HIDE = 0x0
local SW_SHOW = 0x5
local SW_POWERSHELL = DEBUG_STATUS and SW_SHOW or SW_HIDE

local ERROR_SUCCESS    = 0x0
local HKEY_CURRENT_USER = ffi.cast("void*", 0x80000001)
local HKEY_STEAM_SUB_PATH = "Software\\Valve\\Steam"
local KEY_QUERY_VALUE  = 0x0001
local GENERIC_ALL      = 0x10000000
local CREATE_ALWAYS    = 0x2
local FILE_ATTRIBUTE_NORMAL = 0x80
local INVALID_HANDLE_VALUE  = ffi.cast("void*", -0x1)

local Advapi32 = ffi.load("Advapi32")
local Shell32  = ffi.load("Shell32")
local Kernel32 = ffi.load("Kernel32")

local cPowerShell_BlockFileName  = "L4D2_BLOCK.dat"
local cPowerShell_UnlockFileName = "L4D2_UNBLOCK.dat"
local cPowerShell_ExitFileName   = "L4D2_EXIT.dat"
local cPowerShell_RuleName       = "L4D2ReconnectBypass"
local cPowerShell_WindowTitle    = "L4D2_PSBridge"

local cFullSteamPath  = ""
local cBackupSteamPath = "C:\\Program Files (x86)\\Steam\\steam.exe"
local TempBridgePath  = ""

local bPowerShellWasInit = false


local ref = gui.Reference("Misc", "General", "Extra")
local enable_ref  = gui.Checkbox(ref, "rcb.on",  "Block Steam Conn",  false)
local status_text = gui.Text(ref, "rcb.status", "Status: --")


local function GetSteamPath()
    if not Advapi32 then
        cFullSteamPath = cBackupSteamPath
        return
    end

    local hKey = ffi.new("void*[1]")
    local ok, res = pcall(function()
        return Advapi32.RegOpenKeyExA(HKEY_CURRENT_USER, HKEY_STEAM_SUB_PATH, 0, KEY_QUERY_VALUE, hKey)
    end)

    if ok and res == ERROR_SUCCESS then
        local buf  = ffi.new("unsigned char[1024]")
        local bsz  = ffi.new("unsigned long[1]", 1024)
        ok, res = pcall(function()
            return Advapi32.RegQueryValueExA(hKey[0], "SteamExe", nil, nil, buf, bsz)
        end)
        cFullSteamPath = (ok and res == ERROR_SUCCESS)
            and ffi.string(buf):gsub("/", "\\")
            or cBackupSteamPath
        pcall(function() Advapi32.RegCloseKey(hKey[0]) end)
    else
        cFullSteamPath = cBackupSteamPath
    end
end


local function InitPowerShellScript()
    TempBridgePath = cFullSteamPath:gsub("\\steam%.exe", "")

   
    local ps = string.format([[
        Start-Sleep -Milliseconds 150;
        Remove-Item -Path '%s' -Force -ErrorAction SilentlyContinue;
        Set-ItemProperty -Path 'HKLM:\SYSTEM\CurrentControlSet\Services\mpssvc' -Name 'Start' -Value 2;
        Start-Sleep -Milliseconds 100;
        net start mpssvc;
        Start-Sleep -Milliseconds 100;
        netsh advfirewall set allprofiles state on;
        Get-Process 'powershell' -ErrorAction SilentlyContinue |
            Where-Object { $_.MainWindowTitle -match '%s' } | Stop-Process -Force;
        Start-Sleep -Milliseconds 100;
        $host.UI.RawUI.WindowTitle = '%s';
        while ([bool](Get-Process -Name 'left4dead2' -ErrorAction SilentlyContinue)) {
            if (Test-Path -Path '%s') {
                Start-Sleep -Milliseconds 100;
                Remove-Item -Path '%s' -Force;
                Remove-NetFirewallRule -DisplayName '%s' -ErrorAction SilentlyContinue;
                New-NetFirewallRule -DisplayName '%s' -Direction Outbound -Action Block -Program '%s';
            }
            if (Test-Path -Path '%s') {
                Start-Sleep -Milliseconds 100;
                Remove-Item -Path '%s' -Force;
                Remove-NetFirewallRule -DisplayName '%s' -ErrorAction SilentlyContinue;
            }
            if (Test-Path -Path '%s') {
                Start-Sleep -Milliseconds 100;
                Remove-Item -Path '%s' -Force;
                Remove-NetFirewallRule -DisplayName '%s' -ErrorAction SilentlyContinue;
                break;
            }
            Start-Sleep -Milliseconds 100;
        }
        Remove-NetFirewallRule -DisplayName '%s' -ErrorAction SilentlyContinue;
        Start-Sleep -Milliseconds 3000;
    ]],
        
        TempBridgePath .. '\\' .. cPowerShell_ExitFileName,
        cPowerShell_WindowTitle, cPowerShell_WindowTitle,
        TempBridgePath .. '\\' .. cPowerShell_BlockFileName,
        TempBridgePath .. '\\' .. cPowerShell_BlockFileName,
        cPowerShell_RuleName, cPowerShell_RuleName, cFullSteamPath,
        TempBridgePath .. '\\' .. cPowerShell_UnlockFileName,
        TempBridgePath .. '\\' .. cPowerShell_UnlockFileName,
        cPowerShell_RuleName,
        TempBridgePath .. '\\' .. cPowerShell_ExitFileName,
        TempBridgePath .. '\\' .. cPowerShell_ExitFileName,
        cPowerShell_RuleName,
        cPowerShell_RuleName
    )

    
    ps = ps:gsub("\n%s*", " ")

    local args = '-ExecutionPolicy Bypass -Command "' .. ps .. '"'
    if DEBUG_STATUS then
        args = '-NoExit ' .. args
        print("[RCB] PS args: " .. args)
    else
        args = '-WindowStyle Hidden ' .. args
    end

    local ok, hInst = pcall(function()
        return Shell32.ShellExecuteA(nil, "runas", "powershell.exe", args, nil, SW_POWERSHELL)
    end)

    if ok and tonumber(ffi.cast("intptr_t", hInst)) > 32 then
        print("[RCB] PowerShell baslatildi")
        return true
    else
        print("[RCB] HATA: Admin yetkisi gerekli!")
        return false
    end
end


local function CreateActionFile(fileName)
    if not Kernel32 then return false end
    local fullPath = TempBridgePath .. '\\' .. fileName
    local ok, hFile = pcall(function()
        return Kernel32.CreateFileA(fullPath, GENERIC_ALL, 0, nil, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nil)
    end)
    if ok and hFile ~= INVALID_HANDLE_VALUE then
        pcall(function() Kernel32.CloseHandle(hFile) end)
        return true
    end
    print("[RCB] Dosya olusturulamadi: " .. fullPath)
    return false
end


local function EnsureInit()
    if not bPowerShellWasInit then
        GetSteamPath()
        if InitPowerShellScript() then
            bPowerShellWasInit = true
        end
    end
    return bPowerShellWasInit
end


local last_val = false
callbacks.Register("Draw", "rcb_toggle", function()
    local val = enable_ref:GetValue()
    if val == last_val then return end
    last_val = val

    if val then
        if EnsureInit() then
            if CreateActionFile(cPowerShell_BlockFileName) then
                print("[RCB] Steam ENGELLENDI")
            end
        end
    else
        if EnsureInit() then
            if CreateActionFile(cPowerShell_UnlockFileName) then
                print("[RCB] Steam engeli KALDIRILDI")
            end
        end
    end
end)


callbacks.Register("Unload", function()
    if bPowerShellWasInit then
        CreateActionFile(cPowerShell_ExitFileName)
        print("[RCB] Temizlendi")
    end
end)

print("[RCB] Yuklendi")
